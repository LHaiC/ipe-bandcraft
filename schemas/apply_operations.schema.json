{
  "$defs": {
    "Box": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "description": "left edge, API coordinates: top-left origin, +x right, +y down, units bp (1/72 in). Ipe-native bottom-left y-up conversion is internal.",
          "title": "X",
          "type": "number"
        },
        "y": {
          "description": "top edge (down-positive), API coordinates: top-left origin, +x right, +y down, units bp (1/72 in). Ipe-native bottom-left y-up conversion is internal.",
          "title": "Y",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "Box",
      "type": "object"
    },
    "BoxPatch": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        },
        "width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        },
        "height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        }
      },
      "title": "BoxPatch",
      "type": "object"
    },
    "EdgeCreate": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "edge.create",
          "title": "Op",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Endpoint"
        },
        "target": {
          "$ref": "#/$defs/Endpoint"
        },
        "routing": {
          "discriminator": {
            "mapping": {
              "auto": "#/$defs/RoutingAuto",
              "manual": "#/$defs/RoutingManual",
              "orthogonal": "#/$defs/RoutingAuto",
              "straight": "#/$defs/RoutingAuto"
            },
            "propertyName": "mode"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/RoutingAuto"
            },
            {
              "$ref": "#/$defs/RoutingManual"
            }
          ],
          "title": "Routing"
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "role": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        }
      },
      "required": [
        "op",
        "id",
        "source",
        "target",
        "routing"
      ],
      "title": "EdgeCreate",
      "type": "object"
    },
    "EdgeUpdate": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "edge.update",
          "title": "Op",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "changes": {
          "$ref": "#/$defs/EdgeUpdateChanges"
        }
      },
      "required": [
        "op",
        "id",
        "changes"
      ],
      "title": "EdgeUpdate",
      "type": "object"
    },
    "EdgeUpdateChanges": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Endpoint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target": {
          "anyOf": [
            {
