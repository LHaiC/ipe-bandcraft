          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "auto": "#/$defs/RoutingAuto",
                  "manual": "#/$defs/RoutingManual",
                  "orthogonal": "#/$defs/RoutingAuto",
                  "straight": "#/$defs/RoutingAuto"
                },
                "propertyName": "mode"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/RoutingAuto"
                },
                {
                  "$ref": "#/$defs/RoutingManual"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Routing"
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextPatch"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "role": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        }
      },
      "title": "EdgeUpdateChanges",
      "type": "object"
    },
    "Endpoint": {
      "additionalProperties": false,
      "properties": {
        "node": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Node",
          "type": "string"
        },
        "port": {
          "anyOf": [
            {
              "$ref": "#/$defs/Port"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "node"
      ],
      "title": "Endpoint",
      "type": "object"
    },
    "IconCreate": {
      "additionalProperties": false,
      "description": "Curated native-path icon (see list_presets(kind='icon')).",
      "properties": {
        "op": {
          "const": "icon.create",
          "title": "Op",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "box": {
          "$ref": "#/$defs/Box"
        },
        "role": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        }
      },
      "required": [
        "op",
        "id",
        "name",
        "box"
      ],
      "title": "IconCreate",
      "type": "object"
    },
    "LayerCreate": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "layer.create",
          "title": "Op",
          "type": "string"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "visible": {
          "default": true,
          "title": "Visible",
          "type": "boolean"
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        }
      },
      "required": [
        "op",
        "name"
      ],
      "title": "LayerCreate",
      "type": "object"
    },
    "NodeCreate": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "node.create",
          "title": "Op",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "shape": {
          "enum": [
            "rect",
            "rounded_rect",
            "ellipse",
            "diamond"
          ],
          "title": "Shape",
          "type": "string"
        },
        "box": {
          "$ref": "#/$defs/Box",
          "description": "absolute placement, API coordinates: top-left origin, +x right, +y down, units bp (1/72 in). Ipe-native bottom-left y-up conversion is internal."
        },
        "label": {
          "$ref": "#/$defs/Text"
        },
        "role": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "style_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Style Id"
        },
        "corner_radius_bp": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corner Radius Bp"
        }
      },
      "required": [
        "op",
        "id",
        "shape",
        "box",
        "label"
      ],
      "title": "NodeCreate",
      "type": "object"
    },
    "NodeUpdate": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "node.update",
          "title": "Op",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "changes": {
          "$ref": "#/$defs/NodeUpdateChanges"
        }
      },
      "required": [
        "op",
        "id",
        "changes"
      ],
      "title": "NodeUpdate",
      "type": "object"
    },
    "NodeUpdateChanges": {
      "additionalProperties": false,
      "properties": {
        "box": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoxPatch"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "absolute box (move/resize), API coordinates: top-left origin, +x right, +y down, units bp (1/72 in). Ipe-native bottom-left y-up conversion is internal. Prefer over objects.translate when targeting a position."
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextPatch"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "role": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "style_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Style Id"
        }
      },
      "title": "NodeUpdateChanges",
      "type": "object"
    },
    "ObjectsDelete": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "objects.delete",
          "title": "Op",
          "type": "string"
        },
        "ids": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_.\\-]{0,63}$",
            "type": "string"
          },
          "maxItems": 500,
          "minItems": 1,
          "title": "Ids",
          "type": "array"
        },
        "cascade_edges": {
          "default": false,
          "title": "Cascade Edges",
          "type": "boolean"
        }
      },
      "required": [
        "op",
        "ids"
      ],
      "title": "ObjectsDelete",
      "type": "object"
    },
    "ObjectsGroup": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "objects.group",
          "title": "Op",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "ids": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_.\\-]{0,63}$",
            "type": "string"
          },
          "maxItems": 500,
          "minItems": 2,
          "title": "Ids",
          "type": "array"
        }
      },
      "required": [
        "op",
        "id",
        "ids"
      ],
      "title": "ObjectsGroup",
      "type": "object"
    },
    "ObjectsMoveTo": {
      "additionalProperties": false,
      "description": "Absolute-position move: places each object's bbox anchor at (x, y).",
      "properties": {
        "op": {
          "const": "objects.move_to",
          "title": "Op",
          "type": "string"
        },
        "ids": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_.\\-]{0,63}$",
            "type": "string"
          },
          "maxItems": 500,
          "minItems": 1,
          "title": "Ids",
          "type": "array"
        },
        "x": {
          "description": "target x, API coordinates: top-left origin, +x right, +y down, units bp (1/72 in). Ipe-native bottom-left y-up conversion is internal.",
          "title": "X",
          "type": "number"
        },
        "y": {
          "description": "target y, API coordinates: top-left origin, +x right, +y down, units bp (1/72 in). Ipe-native bottom-left y-up conversion is internal.",
          "title": "Y",
          "type": "number"
        },
        "anchor": {
          "default": "top_left",
          "description": "which point of each object's bbox lands on (x, y)",
          "enum": [
            "top_left",
            "center"
          ],
          "title": "Anchor",
          "type": "string"
        }
      },
      "required": [
        "op",
        "ids",
        "x",
        "y"
      ],
      "title": "ObjectsMoveTo",
      "type": "object"
    },
    "ObjectsTranslate": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "objects.translate",
          "title": "Op",
          "type": "string"
        },
        "ids": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_.\\-]{0,63}$",
            "type": "string"
          },
          "maxItems": 500,
          "minItems": 1,
          "title": "Ids",
          "type": "array"
        },
        "dx": {
          "description": "relative horizontal move (+x right, bp)",
          "title": "Dx",
          "type": "number"
        },
        "dy": {
          "description": "relative vertical move, +y DOWN in API coords (positive dy moves objects visually downward). For absolute placement use objects.move_to or node.update.box.",
          "title": "Dy",
          "type": "number"
        }
      },
      "required": [
        "op",
        "ids",
        "dx",
        "dy"
      ],
      "title": "ObjectsTranslate",
      "type": "object"
    },
    "ObjectsUngroup": {
      "additionalProperties": false,
      "properties": {
        "op": {
