    "RoutingManual": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "manual",
          "title": "Mode",
          "type": "string"
        },
        "waypoints": {
          "items": {
            "$ref": "#/$defs/Point"
          },
