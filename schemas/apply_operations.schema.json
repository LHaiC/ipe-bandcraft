        "segments": {
          "anyOf": [
            {
              "items": {
                "discriminator": {
                  "mapping": {
                    "C": "#/$defs/SegCubic",
                    "L": "#/$defs/SegLine",
                    "M": "#/$defs/SegMove",
                    "Z": "#/$defs/SegClose"
                  },
                  "propertyName": "cmd"
                },
                "oneOf": [
                  {
                    "$ref": "#/$defs/SegMove"
                  },
                  {
                    "$ref": "#/$defs/SegLine"
                  },
                  {
                    "$ref": "#/$defs/SegCubic"
                  },
                  {
                    "$ref": "#/$defs/SegClose"
                  }
                ]
              },
              "maxItems": 1024,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Segments"
        },
        "stroke_width_bp": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stroke Width Bp"
        },
        "role": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "obstacle": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Obstacle"
        }
      },
      "title": "PathUpdateChanges",
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "description": "horizontal position, API coordinates: top-left origin, +x right, +y down, units bp (1/72 in). Ipe-native bottom-left y-up conversion is internal.",
          "title": "X",
          "type": "number"
        },
        "y": {
          "description": "vertical position (down-positive), API coordinates: top-left origin, +x right, +y down, units bp (1/72 in). Ipe-native bottom-left y-up conversion is internal.",
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Point",
      "type": "object"
    },
    "Port": {
      "additionalProperties": false,
      "properties": {
        "side": {
          "enum": [
            "north",
            "east",
            "south",
            "west",
            "auto"
          ],
          "title": "Side",
          "type": "string"
        },
        "offset": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
