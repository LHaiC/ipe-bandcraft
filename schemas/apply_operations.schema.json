          "type": "string"
        }
      },
      "required": [
        "op",
        "id"
      ],
      "title": "ObjectsUngroup",
      "type": "object"
    },
    "PathCreate": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "path.create",
          "title": "Op",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "segments": {
          "items": {
            "discriminator": {
              "mapping": {
                "C": "#/$defs/SegCubic",
                "L": "#/$defs/SegLine",
                "M": "#/$defs/SegMove",
                "Z": "#/$defs/SegClose"
              },
              "propertyName": "cmd"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/SegMove"
              },
              {
                "$ref": "#/$defs/SegLine"
              },
              {
                "$ref": "#/$defs/SegCubic"
              },
              {
                "$ref": "#/$defs/SegClose"
              }
            ]
          },
          "maxItems": 1024,
          "minItems": 2,
          "title": "Segments",
          "type": "array"
        },
        "stroke_width_bp": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stroke Width Bp"
        },
        "role": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "obstacle": {
          "default": false,
          "title": "Obstacle",
          "type": "boolean"
        }
      },
      "required": [
        "op",
        "id",
        "segments"
      ],
      "title": "PathCreate",
      "type": "object"
    },
    "PathUpdate": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "path.update",
          "title": "Op",
